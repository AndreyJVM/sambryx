FROM ubuntu:22.04

# Disable interactive apt prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install SSH server, Samba and utilities
RUN apt-get update && apt-get install -y \
    openssh-server \
    sudo \
    smbclient \
    vim \
    && rm -rf /var/lib/apt/lists/*

# Configure password login for the disposable sandbox administrator
RUN mkdir /var/run/sshd && \
    sed -i 's/#PermitRootLogin prohibit-password/PermitRootLogin no/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication yes/PasswordAuthentication yes/' /etc/ssh/sshd_config

# Copy configuration files and scripts into the image
COPY scripts/sandbox/systemctl-stub.sh /usr/bin/systemctl
COPY scripts/sandbox/entrypoint.sh /entrypoint.sh
COPY config/smb-base.conf /tmp/smb-base.conf
COPY scripts/setup-samba-server.sh /setup-samba-server.sh
COPY scripts/sandbox/setup-test-data.sh /setup-test-data.sh

# Set script permissions
RUN chmod +x /usr/bin/systemctl /entrypoint.sh /setup-samba-server.sh /setup-test-data.sh

# Initialize the Samba admin user non-interactively
RUN useradd -m -s /bin/bash admin && /setup-samba-server.sh admin

# Prepare directories and the base Samba configuration
RUN mkdir -p /srv/samba/public && \
    chown -R admin:admin /srv/samba/public && \
    chmod -R 0777 /srv/samba/public && \
    mv /etc/samba/smb.conf /etc/samba/smb.conf.bak && \
    cp /tmp/smb-base.conf /etc/samba/smb.conf && \
    chmod 0644 /etc/samba/smb.conf

# Generate test data for the developer sandbox
RUN /setup-test-data.sh && rm -f /etc/ssh/ssh_host_*

# Expose SSH (22) and Samba (139, 445) ports
EXPOSE 22 139 445

CMD ["/entrypoint.sh"]
