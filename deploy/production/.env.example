# Keep the existing project name when upgrading an existing deployment.
COMPOSE_PROJECT_NAME=sambryx-production
# Select a published release tag or digest, never latest.
SAMBRYX_IMAGE=andreyvorobevaqa/sambryx:REPLACE_WITH_RELEASE_TAG

# Match the owner of the TLS private key; both IDs must be nonzero.
PROXY_UID=1000
PROXY_GID=1000

# Paths are relative to the repository root, not this file.
TLS_CERT_FILE=./deploy/production/secrets/fullchain.pem
TLS_KEY_FILE=./deploy/production/secrets/privkey.pem
HTTPS_BIND_IP=127.0.0.1
HTTPS_PORT=8443

# Only used with docker-compose.samba.yml.
SSH_AUTHORIZED_KEYS_FILE=./deploy/production/secrets/management.pub
SAMBA_BIND_IP=127.0.0.1
SAMBA_PORT=445

# OpenSSH host keys verified through a trusted administrative channel.
SSH_KNOWN_HOSTS_FILE=./deploy/production/secrets/known_hosts
